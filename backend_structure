
import java.util.ArrayList;
import java.util.List;

// Parent class: demonstrates abstraction and inheritance
abstract class FinanceRecord {
    protected String name;
    protected double amount;

    public FinanceRecord(String name, double amount) {
        this.name = name;
        this.amount = amount;
    }

    public abstract String getCategory();
}

// Child class: Expenses
class Expense extends FinanceRecord {
    private String category;

    public Expense(String name, double amount, String category) {
        super(name, amount);
        this.category = category;
    }

    @Override
    public String getCategory() {
        return category;
    }
}

// Child class: Savings
class SavingsGoal extends FinanceRecord {
    private double target;
    private String duration;

    public SavingsGoal(String name, double saved, double target,
                       String duration) {
        super(name, saved);
        this.target = target;
        this.duration = duration;
    }

    @Override
    public String getCategory() {
        return duration;
    }

    public double getTarget() {
        return target;
    }
}

// Child class: Investments
class Investment extends FinanceRecord {
    private String type;

    public Investment(String name, double amount, String type) {
        super(name, amount);
        this.type = type;
    }

    @Override
    public String getCategory() {
        return type;
    }
}

// Main backend class
public class FinanceTracker {
    private double income;

    private final List<Expense> expenses = new ArrayList<>();
    private final List<SavingsGoal> savings = new ArrayList<>();
    private final List<Investment> investments = new ArrayList<>();

    public void setIncome(double income) {
        if (income < 0) {
            throw new IllegalArgumentException(
                "Income cannot be negative");
        }
        this.income = income;
    }

    public void addExpense(Expense expense) {
        expenses.add(expense);
    }

    public void addSavings(SavingsGoal goal) {
        savings.add(goal);
    }

    public void addInvestment(Investment investment) {
        investments.add(investment);
    }

    public List<Expense> getExpenses() {
        return expenses;
    }

    public List<SavingsGoal> getSavings() {
        return savings;
    }

    public List<Investment> getInvestments() {
        return investments;
    }

    public double getTotalExpenses() {
        double total = 0;
        for (Expense e : expenses) {
            total += e.amount;
        }
        return total;
    }

    public double getTotalSavings() {
        double total = 0;
        for (SavingsGoal s : savings) {
            total += s.amount;
        }
        return total;
    }

    public double getTotalInvestments() {
        double total = 0;
        for (Investment i : investments) {
            total += i.amount;
        }
        return total;
    }

    public double getBalance() {
        return income - getTotalExpenses()
                      - getTotalSavings()
                      - getTotalInvestments();
    }
}
